---
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  modernize-*,
  cppcoreguidelines-*,
  readability-make-member-function-const,
  hicpp-*,
  modernize-use-noexcept,
  misc-unused-parameters

CheckOptions:
  - key: readability-make-member-function-const.StrictMode
    value: '1'

  - key: modernize-use-auto.MinTypeNameLength
    value: '5'
